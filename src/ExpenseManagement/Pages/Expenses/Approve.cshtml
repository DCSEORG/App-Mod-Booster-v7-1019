@page
@model ExpenseManagement.Pages.Expenses.ApproveModel
@{
    ViewData["Title"] = "Expense Approvals";
}

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check2-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-header mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold"><i class="bi bi-check2-circle me-2"></i>Expense Approvals</h1>
            <p class="mb-0 opacity-75">Manager view — review and approve submitted expenses</p>
        </div>
    </div>

    @if (!Model.PendingExpenses.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-check2-all display-4 d-block mb-2 text-success"></i>
                <h5>All clear!</h5>
                <p>There are no expenses pending approval.</p>
                <a asp-page="/Expenses/Index" class="btn btn-outline-primary">View All Expenses</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header py-3 d-flex align-items-center gap-2">
                        <h5 class="mb-0"><i class="bi bi-clock-history me-2 text-warning"></i>Pending Approval</h5>
                        <span class="badge bg-warning text-dark">@Model.PendingExpenses.Count</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Employee</th>
                                        <th>Description</th>
                                        <th>Category</th>
                                        <th>Amount</th>
                                        <th>Date</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var expense in Model.PendingExpenses)
                                    {
                                        <tr>
                                            <td class="text-muted small">@expense.ExpenseId</td>
                                            <td class="fw-medium">@expense.UserName</td>
                                            <td>@(expense.Description ?? "—")</td>
                                            <td>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                    @expense.CategoryName
                                                </span>
                                            </td>
                                            <td class="fw-semibold">@expense.AmountFormatted</td>
                                            <td class="text-muted small">@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <div class="d-flex gap-1">
                                                    <form method="post" asp-page-handler="Approve">
                                                        <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                                        <button type="submit" class="btn btn-sm btn-success"
                                                                title="Approve" onclick="return confirm('Approve this expense?')">
                                                            <i class="bi bi-check2"></i>
                                                        </button>
                                                    </form>
                                                    <form method="post" asp-page-handler="Reject">
                                                        <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                                        <button type="submit" class="btn btn-sm btn-danger"
                                                                title="Reject" onclick="return confirm('Reject this expense?')">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </form>
                                                    <a asp-page="/Expenses/Details" asp-route-id="@expense.ExpenseId"
                                                       class="btn btn-sm btn-outline-secondary" title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header py-3">
                        <h5 class="mb-0"><i class="bi bi-info-circle me-2 text-primary"></i>Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Pending count:</span>
                            <span class="fw-bold">@Model.PendingExpenses.Count</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Pending total:</span>
                            <span class="fw-bold text-warning">
                                £@((Model.PendingExpenses.Sum(e => e.AmountMinor) / 100m).ToString("N2"))
                            </span>
                        </div>
                        <hr />
                        <p class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i>
                            Click the approve (<i class="bi bi-check2"></i>) or reject
                            (<i class="bi bi-x"></i>) buttons to process each expense.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
