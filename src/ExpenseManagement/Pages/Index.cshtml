@page
@model ExpenseManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 mb-1 fw-bold"><i class="bi bi-speedometer2 me-2"></i>Dashboard</h1>
                <p class="mb-0 opacity-75">Expense Management Overview</p>
            </div>
            <a asp-page="/Expenses/Create" class="btn btn-light">
                <i class="bi bi-plus-circle me-1"></i>New Expense
            </a>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card border-primary h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <div class="stat-value text-primary">@Model.Stats.TotalExpenses</div>
                        <div class="stat-label">Total Expenses</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card border-warning h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div>
                        <div class="stat-value text-warning">
                            @(Model.Stats.StatusCounts.FirstOrDefault(s => s.StatusName == "Submitted")?.Count ?? 0)
                        </div>
                        <div class="stat-label">Pending Approval</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card border-success h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <div>
                        <div class="stat-value text-success">
                            @(Model.Stats.StatusCounts.FirstOrDefault(s => s.StatusName == "Approved")?.Count ?? 0)
                        </div>
                        <div class="stat-label">Approved</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card stat-card border-danger h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-currency-pound"></i>
                    </div>
                    <div>
                        <div class="stat-value text-danger">£@(Model.Stats.TotalAmountDecimal.ToString("N2"))</div>
                        <div class="stat-label">Total Value</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row -->
    <div class="row g-4">
        <!-- Recent Expenses -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0"><i class="bi bi-clock me-2 text-primary"></i>Recent Expenses</h5>
                    <a asp-page="/Expenses/Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentExpenses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Description</th>
                                        <th>Category</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var expense in Model.RecentExpenses)
                                    {
                                        <tr>
                                            <td class="fw-medium">@(expense.Description ?? "—")</td>
                                            <td>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                    @expense.CategoryName
                                                </span>
                                            </td>
                                            <td class="fw-semibold">@expense.AmountFormatted</td>
                                            <td>
                                                <span class="badge badge-status-@expense.StatusName.ToLower()">
                                                    @expense.StatusName
                                                </span>
                                            </td>
                                            <td class="text-muted small">@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <a asp-page="/Expenses/Details" asp-route-id="@expense.ExpenseId"
                                                   class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-2"></i>
                            <p>No expenses yet.</p>
                            <a asp-page="/Expenses/Create" class="btn btn-primary">Add First Expense</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Actions + Status Breakdown -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header py-3">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2 text-primary"></i>Quick Actions</h5>
                </div>
                <div class="card-body d-grid gap-2">
                    <a asp-page="/Expenses/Create" class="btn btn-primary quick-action-btn">
                        <i class="bi bi-plus-circle me-2"></i>Submit New Expense
                    </a>
                    <a asp-page="/Expenses/Approve" class="btn btn-warning quick-action-btn text-dark">
                        <i class="bi bi-check2-circle me-2"></i>Review Pending Approvals
                    </a>
                    <a asp-page="/Expenses/Index" class="btn btn-outline-secondary quick-action-btn">
                        <i class="bi bi-list-ul me-2"></i>View All Expenses
                    </a>
                    <a asp-page="/Chat" class="btn btn-outline-primary quick-action-btn">
                        <i class="bi bi-chat-dots me-2"></i>Ask AI Assistant
                    </a>
                </div>
            </div>

            <div class="card">
                <div class="card-header py-3">
                    <h5 class="mb-0"><i class="bi bi-bar-chart me-2 text-primary"></i>Status Breakdown</h5>
                </div>
                <div class="card-body">
                    @foreach (var status in Model.Stats.StatusCounts)
                    {
                        var pct = Model.Stats.TotalExpenses > 0
                            ? (int)Math.Round((double)status.Count / Model.Stats.TotalExpenses * 100)
                            : 0;
                        var barClass = status.StatusName switch
                        {
                            "Draft" => "bg-secondary",
                            "Submitted" => "bg-primary",
                            "Approved" => "bg-success",
                            "Rejected" => "bg-danger",
                            _ => "bg-secondary"
                        };
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="fw-medium">@status.StatusName</span>
                                <span class="text-muted">@status.Count (@pct%)</span>
                            </div>
                            <div class="progress" style="height:8px;">
                                <div class="progress-bar @barClass" role="progressbar"
                                     style="width: @pct%" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
