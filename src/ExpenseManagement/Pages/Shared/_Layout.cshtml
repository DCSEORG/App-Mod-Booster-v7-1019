<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Expense Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Error Banner (shown when DB connection fails) -->
    @if (ViewData["DbError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-0 rounded-0 border-0" role="alert" id="db-error-banner">
            <div class="container-fluid">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0"></i>
                    <div>
                        <strong>Database Connection Error</strong>
                        <p class="mb-1 small">@ViewData["DbError"]</p>
                        @if (ViewData["DbErrorDetail"] != null)
                        {
                            <p class="mb-1 small text-muted"><code>@ViewData["DbErrorDetail"]</code></p>
                        }
                        <details class="small">
                            <summary class="fw-semibold">Managed Identity Troubleshooting</summary>
                            <ul class="mt-1 mb-0">
                                <li>Ensure <code>AZURE_CLIENT_ID</code> environment variable is set in App Service configuration</li>
                                <li>Ensure the connection string includes <code>User Id=&lt;managed-identity-client-id&gt;</code></li>
                                <li>Verify the managed identity database user was created with correct permissions</li>
                                <li>Confirm the user-assigned managed identity is attached to the App Service</li>
                                <li>Re-run <code>deploy-infra/deploy.ps1</code> to reconfigure settings</li>
                            </ul>
                        </details>
                        <p class="mb-0 mt-1"><em>Showing demo data while the database is unavailable.</em></p>
                    </div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-page="/Index">
                <i class="bi bi-receipt me-2"></i>Expense Manager
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Index">
                            <i class="bi bi-speedometer2 me-1"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Expenses/Index">
                            <i class="bi bi-list-ul me-1"></i>Expenses
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Expenses/Create">
                            <i class="bi bi-plus-circle me-1"></i>New Expense
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Expenses/Approve">
                            <i class="bi bi-check2-circle me-1"></i>Approvals
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Chat">
                            <i class="bi bi-chat-dots me-1"></i>AI Assistant
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/swagger" target="_blank">
                            <i class="bi bi-code-slash me-1"></i>API Docs
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    <main class="py-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-light border-top py-3 mt-auto">
        <div class="container-fluid text-center text-muted small">
            <span><i class="bi bi-receipt me-1"></i>Expense Management System &copy; @DateTime.Now.Year</span>
            <span class="mx-2">&bull;</span>
            <a href="/swagger" class="text-muted text-decoration-none" target="_blank">API Documentation</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
